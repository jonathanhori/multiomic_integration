#!/bin/bash
#SBATCH --job-name=controlled_study
#SBATCH --account=pi_huazhou
#SBATCH --time=12:00:00
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=2
#SBATCH --mem-per-cpu=4G
#SBATCH --array=1-432
#SBATCH --output=cluster/logs/controlled_study.%A_%a.out
##SBATCH --mail-user=CHANGE_ME@mail
##SBATCH --mail-type=END,FAIL

# ---------------------------------------------------------------------------
# Hoffman2 Slurm array job: controlled-strength study, single- and two-factor
# (python/sim_run_controlled_study.py; docs/viper_shared_extensions_design.md).
#
# Before the first submission: cluster/setup_hoffman2.sh (environment, MOFA2), and set
# --account above to your group's Slurm account (h2 whoami; pi_<PI's user name>).
# Submit from the repository root (logs go to cluster/logs/, relative to it):
#   h2 validate cluster/submit_controlled_study.slurm
#   h2 submit   cluster/submit_controlled_study.slurm
#
# Tasks (python python/sim_run_controlled_study.py --list):
#    1-42   single-factor grid, n {100,200,500} x P {600,3000} x 7 c, reps 1-10
#   43-54   single-factor P = 10000 x c {0.3,1,3,10} x n, reps 1-3
#   55-216  two-factor study (one strong, one weak relevant factor): the same (n, P, c)
#           cells x omega_2 {0.25,0.5,0.75} = 162 cells, reps 1-10 (data generated by
#           the task)
#  217-270  single-factor grid again on rescaled data (strength exactly on target), the 54
#           cells of tasks 1-54, reps 1-10, with per-factor diagnostics (data generated
#           by the task)
#  271-432  high-PVE + weak study: one predictive factor as large as the nuisance factors
#           (PVE ~15 %) and one weak predictive factor, the cells of tasks 55-216, reps
#           1-10, with per-factor diagnostics (data generated by the task)
#           Submit only these: h2 submit ... or sbatch --array=271-432 cluster/submit_controlled_study.slurm
# Each task runs all replicates of one cell: VIPER (package defaults, incl. the
# local-inference defaults), local inference with recorded trajectory, MOFA2, PCA,
# ridge, elastic net. The task list is defined in sim_run_controlled_study.tasks(): if
# arms are added there, update --array to match (--list prints the count).
# Output: sim/results/controlled_study/<arm>/scores/<cell>.csv (resumable: resubmitting
# skips finished replicates; e.g. sbatch --array=7,12 ... reruns two tasks).
#
# Time: ~4 min per replicate at P = 600, ~5-8 min at P = 3000, ~20 min at P = 10000, so
# tasks take ~0.7-4 h; 12 h is headroom (campus / shared jobs may run up to 24 h).
# Needs the single-factor data in sim/data/multi_view_shared_controlled/k.5 (~3 GB).
# ---------------------------------------------------------------------------

echo "Task $SLURM_ARRAY_TASK_ID of job $SLURM_ARRAY_JOB_ID started on $(hostname -s) at $(date)"
source cluster/hoffman2_env.sh

python python/sim_run_controlled_study.py --task-id "$SLURM_ARRAY_TASK_ID"

echo "Task $SLURM_ARRAY_TASK_ID ended at $(date)"
